{
  "regions": ["bom1"],
  "trailingSlash": false,
  "redirects": [
    { "source": "/result-card", "destination": "/results", "permanent": true },
    { "source": "/duty", "destination": "/", "permanent": true },
    { "source": "/notes", "destination": "/library", "permanent": true },
    { "source": "/notes/:path*", "destination": "/library", "permanent": true },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|\\.well-known/).*)",
      "has": [{ "type": "host", "value": "(.*\\.)?indevs\\.in" }],
      "destination": "https://ghsbabikhel.dpdns.org/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/llms.txt", "destination": "/api/seo?kind=llms" },
    { "source": "/ai-data.json", "destination": "/api/render?feed=ai" },
    { "source": "/ai.json", "destination": "/api/render?feed=ai" },
    { "source": "/sitemap.xml", "destination": "/api/seo?kind=sitemap" },
    { "source": "/robots.txt", "destination": "/api/seo?kind=robots" },
    { "source": "/rss.xml", "destination": "/api/seo?kind=rss" },
    { "source": "/feed.xml", "destination": "/api/seo?kind=rss" },
    { "source": "/api/ai-data", "destination": "/api/render?feed=ai" },
    { "source": "/api/llms", "destination": "/api/seo?kind=llms" },
    { "source": "/api/sitemap", "destination": "/api/seo?kind=sitemap" },
    { "source": "/api/robots", "destination": "/api/seo?kind=robots" },
    { "source": "/api/rss", "destination": "/api/seo?kind=rss" },
    { "source": "/api/bisep-proxy", "destination": "/api/bisep-proxy" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/admission", "destination": "/admission/index.html" },
    { "source": "/notices", "destination": "/notices/index.html" },
    { "source": "/results", "destination": "/results/index.html" },
    { "source": "/merit-list", "destination": "/merit-list/index.html" },
    { "source": "/roll-no-slip", "destination": "/roll-no-slip/index.html" },
    { "source": "/teachers", "destination": "/teachers/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/library", "destination": "/library/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/((?!api/|assets/|fonts/|\\.well-known/|ai-catalog\\.json).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/bisep-proxy",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon-(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/icon-(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://plausible.io https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: https://*.tile.openstreetmap.org https://apod.nasa.gov https://server.arcgisonline.com https://*.opentopomap.org https://covers.openlibrary.org https://gutendex.com https://newsdata.io https://*.newsdata.io https://api.alquran.cloud https://*.alquran.cloud https://flagcdn.com https://*.flagcdn.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://opentdb.com https://api.cloudinary.com https://restcountries.com https://api.open-meteo.com https://air-quality-api.open-meteo.com https://ipapi.co https://ipwho.is https://freeipapi.com https://api.bigdatacloud.net https://nominatim.openstreetmap.org https://overpass-api.de https://api.rainviewer.com https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://server.arcgisonline.com https://*.opentopomap.org https://api.nasa.gov https://api.wheretheiss.at https://api.open-notify.org https://api.allorigins.win https://numbersapi.com https://plausible.io https://openlibrary.org https://gutendex.com https://newsdata.io https://*.newsdata.io https://pubchem.ncbi.nlm.nih.gov https://services.swpc.noaa.gov https://raw.githubusercontent.com https://countriesnow.space; media-src 'self' https://res.cloudinary.com https://*.supabase.co; frame-src 'self' blob: https: https://www.youtube.com https://youtube.com https://youtu.be https://meet.jit.si https://*.meet.jit.si https://www.geogebra.org https://phet.colorado.edu https://*.phet.colorado.edu; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; frame-ancestors 'self'" },
        { "key": "Access-Control-Allow-Origin", "value": "https://ghsbabikhel.dpdns.org" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-CSRF-Token" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self \"https://meet.jit.si\"), microphone=(self \"https://meet.jit.si\"), display-capture=(self \"https://meet.jit.si\"), autoplay=(self \"https://meet.jit.si\"), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Cross-Origin-Opener-Policy", "value": "unsafe-none" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Server", "value": "" },
        { "key": "X-Powered-By", "value": "" }
      ]
    }
  ]
}
